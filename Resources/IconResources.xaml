<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <DrawingImage x:Key="AppLogoImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#2196F3">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="1,5,30,22" RadiusX="4" RadiusY="4"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 9,15 H 13 V 19 H 19 V 15 H 23 L 16,9 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#BBDEFB">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="9,24" RadiusX="2.5" RadiusY="2.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#BBDEFB">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="23,24" RadiusX="2.5" RadiusY="2.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <Style x:Key="IconGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="IconGlyphSmall" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
        <Setter Property="FontSize" Value="13"/>
    </Style>

</ResourceDictionary>
