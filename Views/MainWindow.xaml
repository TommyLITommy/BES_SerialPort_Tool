<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SerialPortTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SerialPortTool.Views"
        xmlns:vm="clr-namespace:SerialPortTool.ViewModels"
        mc:Ignorable="d"
        Title="串口调试工具" 
        Height="800" Width="900"
        MinHeight="600" MinWidth="600"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="{StaticResource AppLogoImage}">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel"/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource AppLogoImage}" Width="32" Height="32" Margin="0,0,10,0"/>
                    <TextBlock Text="串口调试工具" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="支持动态添加/关闭串口 | 2M波特率 | 正则过滤" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="15,0,0,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource SuccessButton}" Command="{Binding OpenAllCommand}" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE7E8;" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="全部打开" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding CloseAllCommand}" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE711;" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="全部关闭" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshAllCommand}" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" Margin="0,0,6,0"/>
                            <TextBlock Text="刷新串口" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExitCommand}" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE7E7;" Margin="0,0,6,0"/>
                            <TextBlock Text="退出" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 全局状态 + 添加按钮 -->
        <Border Grid.Row="1" Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="0,0,0,1" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding GlobalStatus}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddPortCommand}" Padding="10,4" Height="26" FontSize="12"
                        Visibility="{Binding CanAddPort, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" Foreground="White" Margin="0,0,4,0"/>
                        <TextBlock Text="添加串口" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 动态串口区域 - 使用 ItemsControl -->
        <ItemsControl Grid.Row="2" Margin="10" ItemsSource="{Binding Ports}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:SerialPortControl DataContext="{Binding}" Margin="0,0,5,0"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Row="3" Style="{StaticResource StatusBarStyle}">
            <StatusBarItem>
                <TextBlock Text="串口调试工具 v1.0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="|" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="5,0"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="支持波特率: 9600 - 3Mbps" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="|" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="5,0"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="点击 + 添加第二个串口" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>