<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SerialPortTool.Views.SerialPortControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:SerialPortTool.Models"
             xmlns:conv="clr-namespace:SerialPortTool.Converters"
             xmlns:views="clr-namespace:SerialPortTool.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <conv:BoolToOpenCloseConverter x:Key="BoolToOpenCloseConverter"/>
        <conv:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <conv:BoolToPortButtonBrushConverter x:Key="BoolToPortButtonBrushConverter"/>
        <views:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <views:DirectionColorConverter x:Key="DirectionColorConverter"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>

        <Style x:Key="PresetFieldTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PresetHintTextBox" TargetType="TextBox" BasedOn="{StaticResource PresetFieldTextBox}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>

        <Style x:Key="PresetFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="PresetSmallCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="PresetCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#607D8B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="#263238"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.65"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="1">
                    <Setter Property="Background" Value="#E8F4FD"/>
                    <Setter Property="BorderBrush" Value="#1976D2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PresetIndexBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PresetIconButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetIconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PresetSendButton" TargetType="Button" BasedOn="{StaticResource PresetIconButton}">
            <Setter Property="Foreground" Value="#1B7A2E"/>
            <Setter Property="ToolTip" Value="发送此条"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#0D5C1F"/>
                    <Setter Property="Background" Value="#C8E6C9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PresetDeleteButton" TargetType="Button" BasedOn="{StaticResource PresetIconButton}">
            <Setter Property="Foreground" Value="#C62828"/>
            <Setter Property="ToolTip" Value="删除"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#B71C1C"/>
                    <Setter Property="Background" Value="#FFCDD2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuComboBox" TargetType="ComboBox">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="MenuLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="CompactCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Height="{TemplateBinding Height}" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    BorderBrush="#7A8694"
                                    BorderThickness="1"/>
                            <Path x:Name="Tick"
                                  Grid.Column="0"
                                  Width="9"
                                  Height="7"
                                  Margin="2,0,0,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Data="M 1 3.5 L 3.5 6 L 8 1"
                                  Stroke="White"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="ButtonBase">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8E8E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="ToolTipService.ShowDuration" Value="8000"/>
        </Style>

        <Style x:Key="OpenClosePortButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource BaseButtonStyle}"/>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFEBEE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogPanelBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>

        <Style x:Key="LogPanelHeader" TargetType="Border">
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="CornerRadius" Value="4,4,0,0"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style x:Key="LogPanelClearButton" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFEBEE"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#EF9A9A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogListBoxNoWrap" TargetType="ListBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Consolas, 'Courier New', monospace"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="PresetDrawerColumn" Width="0" MinWidth="0" MaxWidth="640"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="{Binding Config.IsOpen, Converter={StaticResource BoolToColorConverter}}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Config.PortName, FallbackValue='未选择'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PortRunTimeText}" FontSize="12" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Config.IsOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Style="{StaticResource OpenClosePortButton}"
                                Background="{Binding Config.IsOpen, Converter={StaticResource BoolToPortButtonBrushConverter}}"
                                ToolTip="打开或关闭串口"
                                Command="{Binding OpenCloseCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource IconGlyphSmall}">
                                            <Setter Property="Text" Value="&#xE8E6;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Config.IsOpen}" Value="True">
                                                    <Setter Property="Text" Value="&#xE711;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Config.IsOpen, Converter={StaticResource BoolToOpenCloseConverter}}"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="用 Notepad++ 打开当前日志" Command="{Binding OpenLogInNotepadPlusPlusCommand}">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A5;" Foreground="{StaticResource PrimaryBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="打开日志所在文件夹" Command="{Binding OpenLogFolderCommand}">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8B7;" Foreground="{StaticResource PrimaryBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="刷新串口列表" Command="{Binding RefreshPortsCommand}">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" Foreground="{StaticResource PrimaryBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="52" ToolTip="清空日志" Command="{Binding ClearCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyphSmall}" Text="&#xE74D;" Foreground="{StaticResource DangerBrush}" Margin="0,0,3,0"/>
                                <TextBlock Text="清空" FontSize="11" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ToggleButton x:Name="TogglePresetDrawerButton" 
                                  Grid.Column="3"
                                  Style="{StaticResource IconToggleButton}"
                                  Width="52"
                                  IsChecked="False"
                                  ToolTip="预设命令面板"
                                  Checked="TogglePresetDrawer_Checked"
                                  Unchecked="TogglePresetDrawer_Unchecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyphSmall}" Text="&#xE8FD;" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,4,0"/>
                            <TextBlock Text="预设" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <Button Grid.Column="4" Style="{StaticResource CloseButton}" ToolTip="关闭此串口" Command="{Binding ClosePortCommand}" Margin="4,0,0,0">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8BB;" Foreground="{StaticResource DangerBrush}"/>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="3" Padding="6,3" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="2" Text="原始: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding AllDataCount}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="4" Text="匹配: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="{Binding FilteredCount}" FontSize="11" Foreground="{StaticResource WarningBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="6" Text="RX: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="{Binding RxCount}" FontSize="11" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="8" Text="TX: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="9" Text="{Binding TxCount}" FontSize="11" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="串口" Style="{StaticResource MenuLabel}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <ComboBox Style="{StaticResource MenuComboBox}" Width="120" ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding Config.PortName}" IsEnabled="{Binding Config.IsOpen, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="波特率" Style="{StaticResource MenuLabel}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <ComboBox Style="{StaticResource MenuComboBox}" Width="100"
                                          ItemsSource="{x:Static models:SerialPortConfig.BaudRateList}"
                                          SelectedItem="{Binding Config.BaudRate}"
                                          IsEditable="True"
                                          IsEnabled="{Binding Config.IsOpen, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource CompactCheckBox}" Content="HEX显示" IsChecked="{Binding Config.IsHexMode}" Margin="12,0,0,0" ToolTip="接收区以十六进制显示"/>
                        </StackPanel>
                        <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Height="26" Margin="0,0,4,0" VerticalAlignment="Center">
                                <TextBlock Text="正则" Style="{StaticResource MenuLabel}" VerticalAlignment="Center" Margin="0"/>
                            </Grid>
                            <ComboBox Grid.Column="1"
                                      x:Name="FilterRegexComboBox"
                                      ItemsSource="{Binding FilterRegexSuggestions}"
                                      Text="{Binding Config.FilterRegex, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      StaysOpenOnEdit="True"
                                      Height="26"
                                      Padding="6,2"
                                      VerticalContentAlignment="Center"
                                      FontSize="12"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      Background="White"
                                      Loaded="FilterRegexComboBox_Loaded"
                                      PreviewKeyDown="FilterRegexComboBox_PreviewKeyDown"
                                      KeyUp="FilterRegexComboBox_KeyUp"
                                      GotKeyboardFocus="FilterRegexComboBox_GotKeyboardFocus"
                                      DropDownClosed="FilterRegexComboBox_DropDownClosed"/>
                        </Grid>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="应用" Width="45" Height="26" Padding="6,2" FontSize="11" VerticalContentAlignment="Center" Click="ApplyFilterButton_Click"/>
                            <TextBlock Text="{Binding AppliedFilterDisplayText}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource SuccessBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="280"
                                       Visibility="{Binding AppliedFilterDisplayText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                                       ToolTip="{Binding AppliedFilterDisplayText}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Style="{StaticResource CompactCheckBox}" Content="Wireshark Pipe" IsChecked="{Binding WiresharkPipeEnabled}" Margin="0,0,10,0"/>
                        <CheckBox Grid.Column="1" Style="{StaticResource CompactCheckBox}" Content="Ellisys" IsChecked="{Binding EllisysEnabled}" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="2" Text="协议" Style="{StaticResource MenuLabel}"/>
                        <ComboBox Grid.Column="3" Style="{StaticResource MenuComboBox}" Width="76" ItemsSource="{Binding EllisysTransportOptions}" SelectedItem="{Binding EllisysTransport}"/>
                        <TextBlock Grid.Column="4" Text="地址" Style="{StaticResource MenuLabel}" Margin="10,0,4,0"/>
                        <TextBox Grid.Column="5" Style="{StaticResource ModernTextBox}" Text="{Binding EllisysEndpoint, UpdateSourceTrigger=LostFocus}" Height="26" Padding="6,2" FontSize="11" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="状态" Style="{StaticResource MenuLabel}" Margin="10,0,4,0"/>
                        <TextBlock Grid.Column="7" Text="{Binding HciRealtimeStatus}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="4" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*" MinWidth="120"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource LogPanelBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource LogPanelHeader}">
                                <Grid>
                                    <TextBlock Text="原始日志" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource LogPanelClearButton}" HorizontalAlignment="Right"
                                            Command="{Binding ClearCommand}" ToolTip="清空原始与匹配日志">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconGlyphSmall}" Text="&#xE74D;" Foreground="{StaticResource DangerBrush}" Margin="0,0,4,0"/>
                                            <TextBlock Text="清空" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <views:RawLogViewer Grid.Row="1" x:Name="RawLogViewer"/>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" ShowsPreview="False">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Border Background="#CCCCCC" Width="2" CornerRadius="1">
                                    <Border.ToolTip>
                                        <ToolTip Content="拖动调整宽度"/>
                                    </Border.ToolTip>
                                </Border>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <Border Grid.Column="2" Style="{StaticResource LogPanelBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource LogPanelHeader}">
                                <Grid>
                                    <TextBlock Text="匹配日志" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource LogPanelClearButton}" HorizontalAlignment="Right"
                                            Command="{Binding ClearCommand}" ToolTip="清空原始与匹配日志">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconGlyphSmall}" Text="&#xE74D;" Foreground="{StaticResource DangerBrush}" Margin="0,0,4,0"/>
                                            <TextBlock Text="清空" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1" x:Name="FilteredLogListBox" Style="{StaticResource LogListBoxNoWrap}" ItemsSource="{Binding FilteredDisplayData}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <views:HighlightTextBlock SourceText="{Binding DisplayLine}" RegexPattern="{Binding DataContext.Config.FilterRegex, RelativeSource={RelativeSource AncestorType=ListBox}}" BaseForeground="{Binding Direction, Converter={StaticResource DirectionColorConverter}}" FontFamily="Consolas, 'Courier New', monospace" FontSize="12" TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter x:Name="PresetDrawerSplitter" Grid.Column="1" Width="6"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" ShowsPreview="True"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      Visibility="Collapsed" DragCompleted="PresetDrawerSplitter_DragCompleted">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="#90A4AE" Width="3" CornerRadius="2" Margin="1,0">
                        <Border.ToolTip>
                            <ToolTip Content="拖动调整预设面板宽度"/>
                        </Border.ToolTip>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- ===================== Drawer 面板（可拖拽调宽） ===================== -->
        <Border x:Name="PresetDrawer" Grid.Column="2"
                Background="#B0BEC5" BorderBrush="#78909C" BorderThickness="1,0,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="-2" Opacity="0.15" Direction="180"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="预设命令" FontSize="15" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="自动保存 · 支持说明 / String / HEX" FontSize="11" Foreground="#E3F2FD" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource CloseButton}"
                                Foreground="White" Background="#33FFFFFF" Click="ClosePresetDrawer_Click"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Padding="10,8" VerticalScrollBarVisibility="Auto" Background="#CFD8DC">
                    <StackPanel>
                        <Button Content="+ 添加命令" Style="{StaticResource SecondaryButton}"
                                Command="{Binding AddPresetCommand}" Height="30" FontSize="12"
                                Margin="0,0,0,10" HorizontalAlignment="Stretch"/>

                        <ItemsControl ItemsSource="{Binding PresetCommands}" AlternationCount="2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PresetCard}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PresetIndexBadge}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding DisplayIndex}" FontSize="10" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource PresetSmallCombo}"
                                                      Width="88" HorizontalAlignment="Left"
                                                      ItemsSource="{x:Static models:PresetCommandItem.FormatOptions}"
                                                      SelectedItem="{Binding Format, UpdateSourceTrigger=PropertyChanged}"/>

                                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                                <Button Style="{StaticResource PresetSendButton}"
                                                        Command="{Binding DataContext.SendPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Style="{StaticResource PresetIconGlyph}" Text="&#xE768;"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </Button>
                                                <Button Style="{StaticResource PresetDeleteButton}"
                                                        Command="{Binding DataContext.RemovePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding DataContext.CanRemovePresets, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Style="{StaticResource PresetIconGlyph}" Text="&#xE74D;"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </Button>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                                <TextBlock Style="{StaticResource PresetFieldLabel}" Text="说明"/>
                                                <TextBox Style="{StaticResource PresetHintTextBox}"
                                                         Text="{Binding Description, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="描述此条命令的作用，便于识别"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                                <TextBlock Style="{StaticResource PresetFieldLabel}" Text="命令"/>
                                                <TextBox Style="{StaticResource PresetFieldTextBox}"
                                                         Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                                         LostFocus="PresetCommandTextBox_LostFocus"
                                                         FontFamily="Consolas, 'Courier New', monospace"
                                                         ToolTip="String：原文发送；HEX：输入时自动加空格，发送时忽略空格"/>
                                            </StackPanel>

                                            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="延时" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox Grid.Column="1" Style="{StaticResource PresetFieldTextBox}"
                                                         Text="{Binding DelayMs, UpdateSourceTrigger=LostFocus}" Padding="6,4"/>
                                                <TextBlock Grid.Column="2" Text="ms" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                <CheckBox Grid.Column="3" Style="{StaticResource CompactCheckBox}" Content="参与批量" IsChecked="{Binding IsEnabled}" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,10">
                    <StackPanel>
                        <CheckBox Style="{StaticResource CompactCheckBox}" Content="循环批量发送" IsChecked="{Binding LoopBatchSend}" FontSize="12" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="▶ 开始批量" Style="{StaticResource SuccessButton}"
                                    Command="{Binding StartBatchSendCommand}"
                                    IsEnabled="{Binding IsBatchSending, Converter={StaticResource InverseBoolConverter}}"
                                    Height="32" FontSize="12" Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="■ 停止" Style="{StaticResource DangerButton}"
                                    Command="{Binding StopBatchSendCommand}"
                                    IsEnabled="{Binding IsBatchSending}"
                                    Height="32" FontSize="12" Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
